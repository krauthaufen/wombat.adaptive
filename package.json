{
  "name": "@aardworx/wombat.adaptive",
  "version": "0.2.2",
  "description": "Incremental adaptive computations (aval/aset/amap/alist) for the Wombat TypeScript stack. Port of F# FSharp.Data.Adaptive.",
  "license": "MIT",
  "author": "krauthaufen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krauthaufen/wombat.adaptive.git"
  },
  "homepage": "https://github.com/krauthaufen/wombat.adaptive",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wombat",
    "aardvark",
    "adaptive",
    "incremental",
    "reactive",
    "aval",
    "aset",
    "amap",
    "alist",
    "fsharp"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aval": {
      "types": "./dist/aval.d.ts",
      "import": "./dist/aval.js"
    },
    "./aset": {
      "types": "./dist/aset.d.ts",
      "import": "./dist/aset.js"
    },
    "./amap": {
      "types": "./dist/amap.d.ts",
      "import": "./dist/amap.js"
    },
    "./alist": {
      "types": "./dist/alist.d.ts",
      "import": "./dist/alist.js"
    },
    "./datastructures": {
      "types": "./dist/datastructures.d.ts",
      "import": "./dist/datastructures.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "import": "./dist/extensions.js"
    },
    "./traceable": {
      "types": "./dist/traceable.d.ts",
      "import": "./dist/traceable.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "import": "./dist/reference.js"
    },
    "./internal": {
      "types": "./dist/internal/memo.d.ts",
      "import": "./dist/internal/memo.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./plugin/runtime": {
      "types": "./dist/plugin/runtime.d.ts",
      "import": "./dist/plugin/runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "fast-check": "^3.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
